# Скопируйте в .env. Секреты намеренно пусты.
SERVICE_API_KEY=
# Необязательно: отдельные ключи других пользователей через запятую.
ADDITIONAL_API_KEYS=
HOST=127.0.0.1
PORT=8030
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_TOKENIZER_PATH=D:\AIAdvent\advent-day-29-optimized-local-rag\models\tokenizer.json
LOCAL_INDEX_PATH=D:\AIAdvent\advent-day-29-optimized-local-rag\output\structural.sqlite
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MAX_TOKENS=2000
CONTEXT_WINDOW=8192
MAX_OUTPUT_TOKENS=512
RATE_LIMIT=10
RATE_WINDOW_SECONDS=60
GENERATION_CONCURRENCY=1
QUEUE_SIZE=5
QUEUE_TIMEOUT_SECONDS=600
GENERATION_TIMEOUT_SECONDS=120
MAX_BODY_BYTES=65536
HISTORY_LIMIT=100
DATABASE_PATH=data/sessions.sqlite
LOG_PATH=logs/service.jsonl
SYSTEM_PROMPT_PATH=prompts/system.txt
# Пусто = только веб-чат того же origin. Wildcard запрещён.
CORS_ORIGINS=
# Оптимизированный профиль дня 29; ответ ограничен 512 по заданию дня 30.
TEMPERATURE=0.0
TOP_P=0.95
TOP_K=20
PRESENCE_PENALTY=1.5
SEED=28
NUM_GPU=0
NUM_THREAD=4
